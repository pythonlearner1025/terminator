{
  "name": "terminator",
  "description": "Human vs Skynet wave shooter",
  "private": true,
  "type": "module",
  "mainScene": "assets/main.scene.gltf",
  "main": "./main.js",
  "scripts": {
    "dev": "kite3d dev",
    "publish": "kite3d publish",
    "pull": "kite3d pull",
    "test": "node --test test/core/*.test.js",
    "scene": "node tools/build-scene.mjs",
    "benchmark": "node tools/benchmark-world.mjs"
  },
  "devDependencies": {
    "kite3d": "0.15.0"
  },
  "dependencies": {
    "@kite3d/engine": "0.15.0",
    "threepipe": "0.5.1"
  },
  "kite3d": {
    "version": "0.15.0",
    "name": "Terminator: human vs Skynet",
    "scripts": [
      "./scripts/GameManager.script.js",
      "./generators/map.generator.js",
      "./generators/unit-template.generator.js"
    ],
    "viewer": {
      "msaa": true,
      "tonemap": true,
      "backgroundColor": "#03070d"
    },
    "publish": {
      "exclude": [
        "docs/**",
        "server/**",
        "packages/**",
        "test/**",
        "tools/**"
      ]
    }
  }
}
